<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_task_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_tracking_no_active"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tracking_status_idle"
                android:textSize="11sp"
                android:paddingStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_dimension_chip"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_dimension_dot"
                android:contentDescription="@string/widget_cd_dimension_color" />

            <TextView
                android:id="@+id/widget_dimension"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/widget_tracking_tap_to_start"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Chronometer
                android:id="@+id/widget_duration_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_duration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--:--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

    <!-- Action button -->
    <ImageView
        android:id="@+id/widget_action_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="@string/widget_cd_toggle_tracking"
        android:padding="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
