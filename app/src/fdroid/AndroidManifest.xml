<!-- Layered only for the F-Droid build: the installer path that needs this
     permission is not shipped in that APK, and with no self-updater that
     flavour has no network user either. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
</manifest>
